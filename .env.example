# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# Production values are injected from the platform secret store.
# ---------------------------------------------------------------------------

# --- Global ---------------------------------------------------------------
ENVIRONMENT=development           # development | test | staging | production
DEBUG=true
PROJECT_NAME=Acme SaaS
LOG_LEVEL=INFO
TZ=UTC

# --- Backend (FastAPI) --------------------------------------------------------
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000
SECRET_KEY=dev-only-change-me-please-0000000000000000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10

# --- PostgreSQL --------------------------------------------------------------
# Single shared database for every service — the backend monolith and the
# sap-integration / masterdata / rack microservices all connect to the same
# physical database. Each service owns its own PostgreSQL schema inside it
# (see the *_DATABASE_URL entries below) and never touches another service's
# schema; the backend's own tables live in the default `public` schema.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=acme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/acme
# Point at a read replica when one exists; falls back to DATABASE_URL if unset.
DATABASE_RO_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- SAP Integration Service (services/sap-integration/) -------------------
# Same physical database as above — tables live in the `sap` schema.
# Docker: host is `postgres`. Native local run: `localhost:5432/acme`.
SAP_DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/acme
SAP_SERVICE_PORT=8001
SAP_PROVIDER=mock                 # mock | (real providers pending TITAN SAP spec)
SAP_SOURCE_SYSTEM=SAP-ECC
# Automatic SAP pull (services/sap-integration/app/sync_loop.py). Safe with the
# mock provider; review before pointing SAP_PROVIDER at a real SAP system.
SAP_AUTO_SYNC_ENABLED=true
SAP_AUTO_SYNC_SECONDS=300         # seconds between pulls
SAP_AUTO_SYNC_COUNT=20            # lines requested per pull
SAP_AUTO_SYNC_START_DELAY_SECONDS=15
SAP_ADMIN_PASSWORD=sap-admin
# true skips JWT verification — isolated local testing only (same for the
# MASTERDATA_ / RACK_ variants below).
SAP_AUTH_OPTIONAL=false

# --- Masterdata Service (services/masterdata/) ----------------------------
# Same physical database as above — tables live in the `masterdata` schema.
# Docker: host is `postgres`. Native local run: `localhost:5432/acme`.
MASTERDATA_DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/acme
MASTERDATA_SERVICE_PORT=8002
MASTERDATA_ADMIN_PASSWORD=masterdata-admin
MASTERDATA_AUTH_OPTIONAL=false
# Read-only HTTP import source for `python -m app.seed` (never a DB connection).
MASTERDATA_SAP_API_BASE_URL=http://sap-integration:8001/api/v1/sap
MASTERDATA_SEED_TOKEN=

# --- Rack Service (services/rack/) ---------------------------------------
# Same physical database as above — tables live in the `rack` schema.
# Docker: host is `postgres`. Native local run: `localhost:5432/acme`.
RACK_DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/acme
RACK_SERVICE_PORT=8003
RACK_ADMIN_PASSWORD=rack-admin
RACK_AUTH_OPTIONAL=false
# Read-only HTTP check of model_no against the Masterdata service (never its DB).
# A blank token makes the service mint its own short-lived token from SECRET_KEY.
RACK_MASTERDATA_API_BASE_URL=http://masterdata:8002/api/v1/masterdata
RACK_MASTERDATA_TOKEN=
RACK_VALIDATE_MODEL=false
# Place SAP outward lines into empty trays on startup (or POST /api/v1/rack/allocate).
RACK_AUTO_ALLOCATE=false

# --- Status Service (services/status/) ------------------------------------
# Same physical database as above — tables live in the `status` schema.
# Single source of truth for a SAP line's status per stage (outward / inward /
# rack): Masterdata and Rack report changes to it, SAP Integration reads it.
STATUS_DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/acme
STATUS_SERVICE_PORT=8004
STATUS_AUTH_OPTIONAL=false
# How the other services reach it (blank *_STATUS_TOKEN = mint from SECRET_KEY).
MASTERDATA_STATUS_API_BASE_URL=http://status:8004/api/v1/status
MASTERDATA_STATUS_TOKEN=
RACK_STATUS_API_BASE_URL=http://status:8004/api/v1/status
RACK_STATUS_TOKEN=
SAP_STATUS_API_BASE_URL=http://status:8004/api/v1/status
SAP_STATUS_TOKEN=

# --- Redis ----------------------------------------------------------------
# Native local run without Redis: set REDIS_ENABLED=false.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SECONDS=300
RATE_LIMIT_DEFAULT=100/minute

# --- Celery -------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=30
CELERY_TASK_TIME_LIMIT=60

# --- Email (dev: MailHog) ---------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_TLS=false
EMAIL_FROM=no-reply@acme.test

# --- Admin panel (/admin, SQLAdmin) --------------------------------------
# The panel reuses SECRET_KEY to sign its session cookie — nothing extra needed.
# The two vars below are read ONLY by `python -m app.admin.create_superuser`
# for non-interactive bootstrap (e.g. first deploy). Leave them unset to be
# prompted interactively. NEVER commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Observability (optional) --------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# --- Frontend (Next.js) -------------------------------------------------------
# Browser-exposed: only NEXT_PUBLIC_* may be sent to the client.
NEXT_PUBLIC_APP_NAME=TITAN
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Server-side only (RSC / route handlers): reach the API directly, bypass Nginx.
API_INTERNAL_BASE_URL=http://backend:8000/api/v1
# Where next.config.ts rewrites each /api/v1 prefix (used when Next serves the
# API paths itself; behind Nginx the same split is done by the proxy).
API_PROXY_TARGET=http://backend:8000/api/v1
SAP_PROXY_TARGET=http://sap-integration:8001/api/v1/sap
MASTERDATA_PROXY_TARGET=http://masterdata:8002/api/v1/masterdata
RACK_PROXY_TARGET=http://rack:8003/api/v1/rack
STATUS_PROXY_TARGET=http://status:8004/api/v1/status
