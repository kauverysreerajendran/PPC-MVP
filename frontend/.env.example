# Frontend env for a MANUAL (no-Docker) local run.
#   copy .env.example .env.local
# Next.js loads .env.local automatically. Only NEXT_PUBLIC_* reaches the browser.

NEXT_PUBLIC_APP_NAME=Acme SaaS

# Browser -> API. In manual mode there is no Nginx, so point straight at FastAPI.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server Components / route handlers -> API (server-side fetch).
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# SAP Integration microservice. /api/v1/sap/* is proxied here by next.config.ts.
SAP_PROXY_TARGET=http://localhost:8001/api/v1/sap

# Masterdata microservice. /api/v1/masterdata/* is proxied here by next.config.ts.
MASTERDATA_PROXY_TARGET=http://localhost:8002/api/v1/masterdata

# Rack microservice. /api/v1/rack/* is proxied here by next.config.ts.
RACK_PROXY_TARGET=http://localhost:8003/api/v1/rack
