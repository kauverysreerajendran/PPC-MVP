# Frontend env for a MANUAL (no-Docker) local run.
#   copy .env.example .env.local
# Next.js loads .env.local automatically. Only NEXT_PUBLIC_* reaches the browser.

NEXT_PUBLIC_APP_NAME=TITAN

# Browser -> API, same-origin. next.config.ts rewrites /api/v1/* to the owning
# process, so the HttpOnly refresh cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server Components / route handlers -> backend (server-side fetch).
API_INTERNAL_BASE_URL=http://127.0.0.1:8000/api/v1

# Everything under /api/v1/* not claimed below goes to the backend monolith.
API_PROXY_TARGET=http://127.0.0.1:8000/api/v1

# SAP Integration microservice. /api/v1/sap/* is proxied here.
SAP_PROXY_TARGET=http://127.0.0.1:8001/api/v1/sap

# Masterdata microservice. /api/v1/masterdata/* is proxied here.
MASTERDATA_PROXY_TARGET=http://127.0.0.1:8002/api/v1/masterdata

# Rack microservice. /api/v1/rack/* is proxied here.
RACK_PROXY_TARGET=http://127.0.0.1:8003/api/v1/rack

# Status microservice. /api/v1/status/* is proxied here.
STATUS_PROXY_TARGET=http://127.0.0.1:8004/api/v1/status
